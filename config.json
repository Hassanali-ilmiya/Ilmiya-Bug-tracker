{
  "sources": [
    { "type": "github", "org": "ilmiya", "author": "Hassanali-ilmiya", "exclude": [], "kinds": ["issue"] }
  ],
  "readProjectFields": false,
  "blockedLabels": ["Blocked"],
  "inReviewLabels": ["In Review"],
  "fixEnvironments": {
    "repos": ["ilmiya/sys", "ilmiya/app", "ilmiya/myilmiya"],
    "branches": [["main", "production"], ["staging", "staging"], ["development", "dev"]]
  },
  "typeLabels": ["Security", "Bug", "Outage", "Feature", "Chore", "Design", "devops"],
  "priority": {
    "titlePattern": "\\b(P[0-3])\\b",
    "order": ["P0", "P1", "P2", "P3"],
    "critical": ["P0"],
    "high": ["P1"]
  },
  "people": { "me": "Hassanali-ilmiya", "taha": "dnur" },
  "staleDays": 7,
  "fullSyncEveryDays": 7,
  "sla": {
    "clock": "calendar",
    "owner": "Tracker policy set by Hassanali-ilmiya on 2026-10-27; not yet confirmed by Taha as company policy.",
    "resolvedWhen": "production-or-closed",
    "policies": [
      { "id": "security", "match": { "type": "Security" }, "responseHours": 24, "resolutionHours": 168 },
      { "id": "bug", "match": { "type": "Bug" }, "responseHours": 24, "resolutionHours": 336 },
      { "id": "outage", "match": { "type": "Outage" }, "responseHours": 24, "resolutionHours": 336 },
      { "id": "default", "match": {}, "responseHours": 72, "resolutionHours": 720 }
    ]
  },
  "slos": [],
  "telemetry": {
    "axiom": { "url": "https://api.axiom.co", "datasets": ["production", "staging", "development"] }
  }
}
