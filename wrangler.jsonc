{
  "name": "ilmiya-bug-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-29",
  // Private tool: served on ilmiya-bug-tracker.<account>.workers.dev, which must sit behind Cloudflare Access
  // (the Worker refuses every request until ACCESS_TEAM_DOMAIN/ACCESS_AUD below are real). No preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "ilmiya-tickets", "database_id": "258cff3f-43ba-4505-a896-10bf29fc1489", "migrations_dir": "migrations" }
  ],
  // 02:00 UTC daily = 07:00 PKT.
  "triggers": { "crons": ["0 2 * * *"] },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://REPLACE_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
  },
  "observability": { "enabled": true }
}
